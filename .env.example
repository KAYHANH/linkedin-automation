# ==============================================================================
# Groq-Powered LinkedIn Automation Configuration
# ==============================================================================

# --- Groq API Configuration ---
# API Key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
# Recommended versatile model supporting tool-use / browser search:
# llama-3.3-70b-versatile or llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# --- LinkedIn Official API Configuration ---
# OAuth 2.0 User Access Token with 'w_member_social' permission
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
# Author Member URN (format: urn:li:person:YOUR_MEMBER_ID)
LINKEDIN_AUTHOR_URN=urn:li:person:YOUR_MEMBER_ID
# Supported LinkedIn API version (format: YYYYMM, e.g., 202501 or 202401)
LINKEDIN_API_VERSION=202501
# Optional: LinkedIn API endpoint style ('rest/posts' for Posts API or 'v2/ugcPosts' for UGC Posts API)
LINKEDIN_ENDPOINT_STYLE=rest/posts

# Optional OAuth application details for token refresh (if supported by app type)
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_REFRESH_TOKEN=your_linkedin_refresh_token_here

# --- GitHub State Storage Configuration ---
# GitHub Personal Access Token (Fine-grained token with Contents: Read & Write)
GITHUB_TOKEN=ghp_your_github_token_here
# Target GitHub repository in 'owner/repo' format
GITHUB_REPOSITORY=owner/repository_name
# Dedicated branch for automation state, outbox, and run history
GITHUB_STATE_BRANCH=automation-state

# --- Safety & Publishing Guardrails ---
# Live publishing switch: MUST be explicitly set to 'true' to publish to LinkedIn
AUTO_PUBLISH=false
# Dry run switch: When true, mock writes and perform no GitHub or LinkedIn API calls
DRY_RUN=true

# --- Execution & Content Controls ---
# Schedule timezone for daily date calculation
PUBLISH_TIMEZONE=Asia/Kolkata
# Post character limit (LinkedIn maximum is 3000; default sweet spot is 900-1300, max 2200)
MAX_POST_CHARACTERS=2200
# Enable Groq browser search tool for current tech/AI research
ENABLE_WEB_SEARCH=true
# Logging verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# --- FounderOS Dashboard Authentication ---
DASHBOARD_USERNAME=founder
# bcrypt password hash (defaults to dev credentials in local dev if empty)
DASHBOARD_PASSWORD_HASH=$2b$12$TQ.YLTnvKmvsPJUgIl2yeeJWuIdj2.7.v6/UqysBTKLxR2wCp3Ev.
# Secret key used for signing session cookies
SESSION_SECRET=generate_a_random_32_character_string_for_production

